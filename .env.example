GROQ_API_KEY=your_groq_api_key_here

# Optional
# QDRANT_URL=http://localhost:6333     # omit to use embedded local storage in ./qdrant_storage
# ADMIN_TOKEN=change-me                # if set, DELETE /api/database/wipe requires X-Admin-Token
# CORS_ORIGINS=http://127.0.0.1:8501   # comma-separated
# MAX_UPLOAD_MB=50
